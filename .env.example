# ============================================================
# MAN-U-AI — Environment Variables (copy to .env and fill in)
# NEVER commit actual secrets to Git
# ============================================================

# ----- API Server -----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ----- JWT -----
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=30d

# ----- MongoDB -----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/man-u-ai?retryWrites=true&w=majority

# ----- Vector Search -----
# Set to "mongodb" if your Atlas cluster supports Vector Search
# Set to "chromadb" or "pinecone" to use a dedicated vector DB adapter
VECTOR_STORE=mongodb
# Required only when VECTOR_STORE=pinecone:
# PINECONE_API_KEY=
# PINECONE_INDEX=

# ----- Object Storage (private, server-side only) -----
# Supported: local | cloudinary | s3 | gcs
STORAGE_PROVIDER=cloudinary
STORAGE_LOCAL_PATH=./uploads

# Cloudinary (when STORAGE_PROVIDER=cloudinary)
# Enables Render Free tier deployment without requiring a persistent disk
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Or combined URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# S3 / R2 (when STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=man-u-ai-docs

# GCS (when STORAGE_PROVIDER=gcs)
# GCS_BUCKET=man-u-ai-docs
# GCS_KEY_FILE=./gcs-service-account.json

# ----- Gemini AI -----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ----- Frontend (Vite exposes VITE_ prefixed vars only) -----
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
