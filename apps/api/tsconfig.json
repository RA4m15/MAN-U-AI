{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@man-u-ai/shared": ["../../packages/shared/dist/index"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
